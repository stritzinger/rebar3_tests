> /.*/
>= 0

$ rm -rf grisp_generated
>= 0

$ TERM=dumb rebar grisp configure -i false --name=grisp_generated --dest=/tmp/grisp_test_destination
> /.*/
>= 0

$ test -f grisp_generated/src/grisp_generated.app.src
>= 0

$ test -f grisp_generated/rebar.config
>= 0

$ rm -rf grisp_generated
>= 0
